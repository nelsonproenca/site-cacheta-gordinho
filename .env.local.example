# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings > API in the Supabase dashboard, or `supabase status`
# for local dev). See prd.md §8.2.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — bypasses RLS. Never expose to the client/browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fase 5 — Live streaming in-app (MediaMTX já rodando na VPS do usuário —
# não SRS, como o plano original assumia; ver prd.md §4.14/§8.2 e o "Fase 5"
# do CLAUDE.md). MEDIAMTX_CALLBACK_SECRET é validado por
# app/api/mediamtx/on-ready e on-not-ready; configure o
# runOnReady/runOnNotReady do path "~^live_(.+)$" no mediamtx.yml
# apontando pra {NEXT_PUBLIC_SITE_URL}/api/mediamtx/on-ready|on-not-ready?secret=<esse valor>&path=$MTX_PATH.
# (nomes confirmados contra a versão real da VPS, v1.9.3 — versões mais
# novas do MediaMTX usam runOnAvailable/runOnUnavailable em vez disso.)
MEDIAMTX_PUBLIC_URL=
MEDIAMTX_RTMP_HOST=
MEDIAMTX_CALLBACK_SECRET=
